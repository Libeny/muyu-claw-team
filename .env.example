APP_NAME=muyu-claw-team
LOG_LEVEL=info

POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/muyu_claw_team
REDIS_URL=redis://127.0.0.1:6379/0

CLAUDE_EXECUTABLE=/opt/homebrew/bin/claude

# Optional: provider / gateway environment, equivalent to your shell exports.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# API_TIMEOUT_MS=3000000
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# ANTHROPIC_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_OPUS_MODEL=

WORKER_CONCURRENCY=2
MERGE_WINDOW_SECONDS=60
SCHEDULER_POLL_SECONDS=15
GROUP_CONTEXT_MESSAGE_LIMIT=30

DISCORD_BOT_TOKEN_DEV=
DISCORD_BOT_TOKEN_OPS=
DISCORD_BOT_TOKEN_DESIGN=
